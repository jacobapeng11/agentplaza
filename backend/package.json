{
  "name": "agent-plaza-backend",
  "version": "1.0.0",
  "description": "Agent Plaza Backend API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "test": "node --test",
    "lint": "eslint src/ --ext .js,.json"
  },
  "keywords": [
    "express",
    "mongodb",
    "api"
  ],
  "author": "Agent Plaza Dev Team",
  "license": "MIT",
  "dependencies": {
    "@wecom/aibot-node-sdk": "^1.0.6",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.0",
    "form-data": "^4.0.5",
    "helmet": "^7.1.0",
    "js-yaml": "^3.14.1",
    "moment": "^2.29.4",
    "mongoose": "^8.0.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.2",
    "redis": "^4.7.1",
    "saxes": "^6.0.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.5",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@paralleldrive/cuid2$": "<rootDir>/tests/helpers/cuid2.cjs"
    },
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
