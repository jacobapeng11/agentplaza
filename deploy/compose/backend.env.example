# Match the browser-facing public origin, without a trailing slash.
FRONTEND_URL=https://plaza.example.com
OAUTH_HOST=https://id.example.com
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Register this exact URI with the identity provider, including the trailing slash.
OAUTH_REDIRECT_URI=https://plaza.example.com/

# Comma-separated employee identifiers returned by the identity provider.
ADMIN_BADGES=
# Optional encryption key for storing integration credentials; use openssl rand -hex 32.
WECOM_BOT_SECRET_ENCRYPTION_KEY=
