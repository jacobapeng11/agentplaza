# Existing MongoDB used by the FastGPT core app; set the exact database name and authSource.
# This example uses a private endpoint with a CA trusted by Node.js.
MONGODB_URI=mongodb://plaza_app:REPLACE_ME@fastgpt-mongo.example.com:27017/fastgpt?authSource=fastgpt&tls=true

# Browser-facing site origin and exact IdTrust-compatible OAuth callback.
FRONTEND_URL=https://plaza.example.com
OAUTH_HOST=https://id.example.com
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://plaza.example.com/
ADMIN_BADGES=

# Customer FastGPT UI and API; use service URLs accessible from the indicated network.
FASTGPT_FRONTEND_BASE_URL=
FASTGPT_DEFAULT_API_BASE_URL=

# Optional MCP market. Use either the console bearer token or the Basic credential pair.
HIGRESS_CONSOLE_BASE_URL=
HIGRESS_GATEWAY_BASE_URL=
HIGRESS_CONSOLE_BEARER_TOKEN=
HIGRESS_CONSOLE_USERNAME=
HIGRESS_CONSOLE_PASSWORD=

# Shared integration credentials encryption key for MCP or WeCom.
WECOM_BOT_SECRET_ENCRYPTION_KEY=

# Optional Skill market, shared by the API and worker. Keep the S3 bucket private.
SKILL_ENABLED=false
SKILL_OSS_BUCKET=
SKILL_OSS_REGION=us-east-1
SKILL_OSS_ENDPOINT=
# Default: true if a custom endpoint is set, false for AWS regional endpoints.
# SKILL_OSS_FORCE_PATH_STYLE=true
SKILL_OSS_ACCESS_KEY_ID=
SKILL_OSS_SECRET_ACCESS_KEY=
SKILL_OSS_SESSION_TOKEN=
