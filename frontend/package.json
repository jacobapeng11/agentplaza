{
  "name": "agent-plaza-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:prod": "vite --mode production",
    "build": "node -r ./polyfill.cjs ./node_modules/vue-tsc/bin/vue-tsc.js && node -r ./polyfill.cjs ./node_modules/vite/bin/vite.js build",
    "build:dev": "node -r ./polyfill.cjs ./node_modules/vue-tsc/bin/vue-tsc.js && node -r ./polyfill.cjs ./node_modules/vite/bin/vite.js build --mode development",
    "build:prod": "node -r ./polyfill.cjs ./node_modules/vue-tsc/bin/vue-tsc.js && node -r ./polyfill.cjs ./node_modules/vite/bin/vite.js build --mode production",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "type-check": "npx vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "axios": "^1.6.8",
    "element-plus": "^2.7.2",
    "lodash-es": "^4.17.21",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/lodash-es": "^4.17.12",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "sass": "^1.77.4",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.6"
  }
}
